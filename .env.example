# Telegram Bot Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Mounted secrets: set NAME_FILE instead of NAME for credentials below.
# A configured file takes precedence; missing/unreadable/empty files fail startup.
# See docs/CONFIGURATION.md for all supported file settings and alias precedence.
# TELEGRAM_TOKEN_FILE=/run/secrets/telegram_token
# OVERSEERR_API_KEY_FILE=/run/secrets/overseerr_api_key
# RADARR_API_KEY_FILE=/run/secrets/radarr_api_key
# SONARR_API_KEY_FILE=/run/secrets/sonarr_api_key
# WEBHOOK_TOKEN_FILE=/run/secrets/webhook_token
# DISCORD_WEBHOOK_URL_FILE=/run/secrets/discord_webhook_url

# Required: Get this from @BotFather on Telegram
TELEGRAM_TOKEN=your_bot_token_here

# Required: Get this from Overseerr settings > API
OVERSEERR_API_KEY=your_overseerr_api_key_here

# Required: Your Telegram chat ID (can get from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Seerr base URL (same pattern as Radarr below).
# Omit on same Compose/K8s network as Seerr (defaults to http://seerr:5055).
# Local / remote examples:
# OVERSEERR_URL=http://localhost:5055
# OVERSEERR_URL=http://host.docker.internal:5055
# Or: OVERSEERR_HOST=overseerr OVERSEERR_PORT=5055
OVERSEERR_URL=http://localhost:5055

# Optional: Radarr (MEDIA_AVAILABLE — downloaded quality + movie folder for movies).
# Same pattern as OVERSEERR_URL: full URL, or RADARR_HOST + RADARR_PORT.
# Omit on same Compose/K8s network as Radarr (defaults to http://radarr:7878).
# RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Optional: Sonarr automation scripts and webhooks.
# Required if you use Sonarr routing or tagging scripts.
SONARR_API_KEY=

# Optional: Webhook server configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=7777
WEBHOOK_PATH=/overseerr/requests

# Required by default: Webhook authentication token
# Set this in bot and webhook sender configuration.
# For trusted private networks only, set ALLOW_INSECURE_WEBHOOKS=true instead.
WEBHOOK_TOKEN=

# Optional explicit override for trusted private networks only.
# Never enable on public or shared networks.
ALLOW_INSECURE_WEBHOOKS=false

# Optional: Timeout (seconds) for Radarr script executions
RADARR_SCRIPT_TIMEOUT=180

# Optional: Sonarr automation dispatch settings
SONARR_SCRIPT_TIMEOUT=180

# Optional: Tautulli automation dispatch settings
TAUTULLI_SCRIPT_TIMEOUT=180

# Optional: Telegram manual action execution settings
MANUAL_ACTION_TIMEOUT=600
MANUAL_ACTION_OUTPUT_LIMIT=3500

# Optional: Comma-separated movie roots used by audio_fix_radarr.py bulk mode
AUDIO_LANG_MOVIES_DIRS=/movies,/movies-hdr

# Optional: Plex settings used by audio_fix_radarr.py for post-fix analyze requests
PLEX_URL=http://localhost:32400
PLEX_TOKEN_FILE=/run/secrets/plex_token
PLEX_SECTION_ID=1

# Optional: Kometa paths used by scripts/check_plex_titles.py
KOMETA_ASSET_DIR=/opt/kometa/config/assets/Movies_Shows
KOMETA_EXCEPTION_MAPPINGS=/opt/kometa/tools/asset-organizer/exception_mappings.json

# Optional: HDR routing settings for route_hdr_on_import_radarr.py
RADARR_SDR_ROOT=/movies
RADARR_HDR_ROOT=/movies-hdr
RADARR_HDR_PROFILE_KEYWORDS=hdr

# Optional: Sonarr audio and HDR routing settings
SONARR_AUDIO_DEFAULT_LANG=eng
SONARR_SDR_ROOT=/tv
SONARR_HDR_ROOT=/tv-hdr
SONARR_HDR_PROFILE_KEYWORDS=hdr
